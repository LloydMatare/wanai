{
  "expo": {
    "name": "Wanai",
    "slug": "wanai-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.wanai.app"
    },
    "android": {
      "package": "com.wanai.app"
    },
    "plugins": [
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Wanai to access your photos to upload document images.",
          "cameraPermission": "Allow Wanai to access your camera to take photos of documents."
        }
      ],
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "wanai-lost-found"
      }
    }
  }
}
